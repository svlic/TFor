TFOR_DATABASE_PATH=./data/tfor.db
TFOR_HOST=0.0.0.0
TFOR_PORT=8000
TFOR_LOG_LEVEL=INFO
TFOR_MAX_CONCURRENT_RULES=10
TFOR_MAX_PENDING_RULES=1000
TFOR_MAX_CONCURRENT_COPIES=4
TFOR_MAX_CONCURRENT_COPIES_PER_ACCOUNT=2
TFOR_INLINE_FLOOD_WAIT_SECONDS=60

# Docker Compose 专用；容器内监听固定为 0.0.0.0:8000，数据库固定为 /app/data/tfor.db。
TFOR_IMAGE=ghcr.io/svlic/tfor:latest
TFOR_BIND_ADDRESS=127.0.0.1
TFOR_PUBLISHED_PORT=8000
